generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model test_table {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model JobPosting {
  id          Int       @id @default(autoincrement())
  title       String
  company     String
  location    String
  description String
  url         String    @unique
  createdAt   DateTime  @default(now())
}

model Skill {
  id          Int       @id @default(autoincrement())
  name        String    
  subskill    String
  createdAt   DateTime  @default(now())
}
